{
  "name": "space-web-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:config": "node scripts/validateGameConfig.mjs",
    "build": "npm run validate:config && tsc && vite build --mode release",
    "build:dev": "npm run validate:config && tsc && vite build --mode development",
    "claim:task": "node scripts/automationTaskClaim.mjs",
    "generate:body-textures": "node scripts/generateBodyTextures.mjs",
    "deploy:netlify": "node scripts/deployNetlify.mjs",
    "deploy:netlify:production": "node scripts/deployNetlify.mjs --mode=production",
    "deploy:netlify:staging": "node scripts/deployNetlify.mjs --mode=staging",
    "deploy:netlify:staging:woven-moth": "node scripts/deployNetlify.mjs --mode=staging --staging-target=woven-moth",
    "preview": "vite preview",
    "lint": "biome lint --write src tests scripts",
    "commitlint": "commitlint --edit $1",
    "format": "biome format --write src tests scripts",
    "test": "vitest run --config vite.config.ts && npm run test:automation-claims",
    "test:automation-claims": "node --test scripts/automationTaskClaim.test.mjs",
    "test:gui": "playwright test --config playwright.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "preact": "^10.29.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.61.1",
    "@preact/preset-vite": "^2.10.5",
    "@types/three": "^0.182.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
