{
  "name": "space-web-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate:config": "node scripts/validateGameConfig.mjs",
    "build": "npm run validate:config && tsc && vite build --mode release",
    "build:dev": "npm run validate:config && tsc && vite build --mode development",
    "preview": "vite preview",
    "lint": "biome lint --write src scripts",
    "commitlint": "commitlint --edit $1",
    "format": "biome format --write src scripts",
    "test": "vitest run"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/three": "^0.182.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.1.4",
    "yaml": "^2.8.3"
  }
}
